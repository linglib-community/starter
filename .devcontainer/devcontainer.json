// Opens this project in GitHub Codespaces (or any dev container host) with Lean,
// linglib and the worked example already set up, and an AI agent extension installed.
{
  "name": "linglib starter",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Runs when the codespace is created, and again whenever a prebuild is refreshed,
  // so prebuilds pick up changes such as a new linglib version. Same script a local
  // agent runs; about 5 minutes from scratch, seconds when nothing changed.
  "updateContentCommand": "bash scripts/setup.sh",

  // Python runs scripts/get_mathlib.py, which downloads only the Mathlib files the project uses.
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "os-provided", "installTools": false }
  },

  // Make lean and lake available in every terminal and to the agent, and keep `lake update`
  // from downloading all of Mathlib (about 7 GB); scripts/build.sh fetches what is needed.
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:${containerEnv:PATH}",
    "MATHLIB_NO_CACHE_ON_UPDATE": "1"
  },

  // Lean needs some memory; Lean and the prebuilt files take about 5 GB of storage.
  "hostRequirements": {
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "MyProject/Example.lean"]
    },
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "anthropic.claude-code"
      ]
    }
  }
}
